.Rhistory
.RData
*.Rproj
.DS_Store
Thumbs.db

# the journal article is copyrighted and stays local; the report PDF is tracked
*.pdf
!report/paaso_replication.pdf

# copyrighted article PDFs stay local; only the list is tracked
papers/*
