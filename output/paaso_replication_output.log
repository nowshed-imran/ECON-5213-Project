. /*--- Figure 3: effect of high debt aversion across estimators (E1, E2) ---*/
. tempname post

. tempfile est

. postfile `post' str25 outcome str12 method b se using `est'

. foreach y in has_debt applied_new_bank_loan {
  2.     if "`y'"=="has_debt" local t hd
  3.     else local t ab
  4.     foreach m in lpm probit logit wls {
  5.         if "`m'"=="wls" estimates restore e2_wls_`t'
  6.         else estimates restore e1_`m'_`t'
  7.         capture scalar bb = _b[1.high_debt_aversion]
  8.         if _rc != 0 scalar bb = _b[high_debt_aversion]
  9.         capture scalar ss = _se[1.high_debt_aversion]
 10.         if _rc != 0 scalar ss = _se[high_debt_aversion]
 11.         post `post' ("`y'") ("`m'") (bb) (ss)
 12.     }
 13. }
(results e1_lpm_hd are active now)
(results e1_probit_hd are active now)
(results e1_logit_hd are active now)
(results e2_wls_hd are active now)
(results e1_lpm_ab are active now)
(results e1_probit_ab are active now)
(results e1_logit_ab are active now)
(results e2_wls_ab are active now)

. postclose `post'

. preserve

. use `est', clear

. gen lo = b - 1.96*se

. gen hi = b + 1.96*se

. gen id = _n

. replace id = id + 1 if outcome=="applied_new_bank_loan"
