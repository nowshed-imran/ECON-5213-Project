. esttab e2_ols_hd e2_wls_hd e2_ols_ab e2_wls_ab ///
>     using "output/ext2_wls.csv", replace keep(high_debt_aversion) ///
>     b(3) se(3) star(* 0.10 ** 0.05 *** 0.01) stats(N, fmt(0)) ///
>     mtitles("Has debt OLS" "Has debt WLS" "Applied OLS" "Applied WLS")
(output written to output/ext2_wls.csv)

. 
. /*--- E3. Functional form of the debt aversion score (ch 6 and 7) ---*/
. * H6: the effect of the 0 to 10 score is linear. alternatives: a dummy for
. *     every score (most flexible), a quadratic, and the reset test.
. 
. file open ff using "output/ext3_functional_form.csv", write replace

. file write ff "outcome,test,stat,df1,df2,p_value" _n

. 
. foreach y in has_debt applied_new_bank_loan {
  2.     if "`y'"=="has_debt" local s s_t3_2
  3.     else local s s_t4_2b
  4.     if "`y'"=="has_debt" local t hd
  5.     else local t ab
  6. 
.     * restricted model: the score enters linearly
.     quietly reg `y' debt_aversion $controls $fe2_dummies if `s'
  7.     scalar ssr_r = e(rss)
  8.     predict yh_`t' if e(sample), xb
  9.     gen yh2_`t' = yh_`t'^2
 10.     gen yh3_`t' = yh_`t'^3
 11. 
.     * unrestricted model: a dummy for each score (score 0 is the base)
.     quietly reg `y' i.debt_aversion $controls $fe2_dummies if `s'
 12.     scalar ssr_ur = e(rss)
 13.     scalar df_ur  = e(df_r)
 14.     * linear = 10 dummy coefficients described by 1 slope: 9 restrictions
.     scalar F_lin = ((ssr_r-ssr_ur)/9)/(ssr_ur/df_ur)
 15.     display "`y' linear vs dummies: F = " F_lin " p = " Ftail(9, df_ur, F_lin)
 16.     file write ff "`y',Linear vs score dummies F," %9.3f (F_lin) ",9," %6.0f (df_ur) "," %9.
> 4f (Ftail(9, df_ur, F_lin)) _n
 17. 
.     * same restriction with clustered errors: b_k = k * b_1 for k = 2 to 10
.     eststo e3_dummies_`t': reg `y' i.debt_aversion $controls $fe2_dummies if `s', vce(cluster m
> unicipality)
 18.     test (_b[2.debt_aversion] = 2*_b[1.debt_aversion])
 19.     forvalues k = 3/10 {
 20.         test (_b[`k'.debt_aversion] = `k'*_b[1.debt_aversion]), accumulate
 21.     }
 22.     file write ff "`y',Linear vs score dummies (clustered Wald F)," %9.3f (r(F)) "," %4.0f (
> r(df)) "," %6.0f (r(df_r)) "," %9.4f (r(p)) _n
 23. 
.     * quadratic in the score
.     capture drop da_sq
 24.     gen da_sq = debt_aversion^2
 25.     eststo e3_quad_`t': reg `y' debt_aversion da_sq $controls $fe2_dummies if `s', vce(clust
> er municipality)
 26.     display "`y' turning point of the quadratic: " -(_b[debt_aversion])/(2*_b[da_sq])
 27.     file write ff "`y',Quadratic term t," %9.3f (_b[da_sq]/_se[da_sq]) ",1," %6.0f (e(df_r))
>  "," %9.4f (2*ttail(e(df_r), abs(_b[da_sq]/_se[da_sq]))) _n
 28. 
.     * reset test: add yhat squared and cubed to the linear model
.     quietly reg `y' debt_aversion yh2_`t' yh3_`t' $controls $fe2_dummies if `s'
 29.     test yh2_`t' yh3_`t'
 30.     file write ff "`y',RESET F," %9.3f (r(F)) "," %4.0f (r(df)) "," %6.0f (r(df_r)) "," %9.4
> f (r(p)) _n
 31. }
