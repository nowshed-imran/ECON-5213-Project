. /*--- Figure 2: effect of each score relative to score 0 (extension E3) ---*/
. * coefficients and standard errors from the score dummy regression
. estimates restore e3_dummies_hd
(results e3_dummies_hd are active now)

. matrix B = e(b)

. matrix V = e(V)

. preserve

. clear

. set obs 11
Number of observations (_N) was 0, now 11.

. gen score = _n - 1

. gen b  = 0

. gen se = 0

. forvalues k = 1/10 {
  2.     replace b  = el(B, 1, colnumb(B, "`k'.debt_aversion")) if score==`k'
  3.     replace se = sqrt(el(V, colnumb(V, "`k'.debt_aversion"), colnumb(V, "`k'.debt_aversion")
> )) if score==`k'
  4. }
(1 real change made)
